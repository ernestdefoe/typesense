{
    "name": "ernestdefoe/typesense",
    "description": "Fast, typo-tolerant Typesense search for Flarum 2 — a free, drop-in search driver.",
    "keywords": ["flarum", "search", "typesense", "fulltext"],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Ernest Defoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "support": {
        "forum": "https://discuss.flarum.org/d/39510-typesense-search-driver",
        "issues": "https://github.com/ernestdefoe/typesense/issues",
        "source": "https://github.com/ernestdefoe/typesense"
    },
    "require": {
        "php": "^8.2",
        "flarum/core": "^2.0",
        "typesense/typesense-php": "^4.9",
        "symfony/http-client": "^6.0 || ^7.0",
        "nyholm/psr7": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "Ernestdefoe\\Typesense\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ernestdefoe\\Typesense\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Typesense Search",
            "category": "feature",
            "icon": {
                "name": "fas fa-bolt-lightning",
                "backgroundColor": "#e63e83",
                "color": "#fff"
            }
        }
    },
    "require-dev": {
        "flarum/phpstan": "^2.0",
        "flarum/testing": "^2.0"
    },
    "scripts": {
        "test": [
            "@test:integration"
        ],
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
